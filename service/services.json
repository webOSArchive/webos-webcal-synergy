{
	"id": "org.webosports.service.webcal",
	"description": "WebCal Synergy Service",
	"engine": "node",
	"activityTimeout": 30,
	"commandTimeout": 300,
	"services": [
		{
			"name": "org.webosports.service.webcal",
			"description": "WebCal Synergy",
			"globalized": false,
			"assistant": "ServiceAssistant",
			"commands": [
				{
					"name": "checkCredentials",
					"assistant": "checkCredentialsAssistant",
					"public": true
				},
				{
					"name": "onCredentialsChanged",
					"assistant": "OnCredentialsChanged",
					"public": true
				},
				{
					"name": "onCalendarCreate",
					"assistant": "OnCreate",
					"public": true
				},
				{
					"name": "onCalendarEnabled",
					"assistant": "OnEnabled",
					"public": true
				},
				{
					"name": "onCalendarDelete",
					"assistant": "OnDelete",
					"public": true
				},
				{
					"name": "sync",
					"assistant": "SyncAssistant",
					"public": true
				},
				{
					"name": "checkStatus",
					"subscribe": true,
					"assistant": "statusAssistant",
					"public": true
				}
			]
		}
	]
}
